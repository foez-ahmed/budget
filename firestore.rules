rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/main).data.memberUids;
    }

    match /households/main {
      allow read: if isMember();
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.type in ['Income', 'Expense']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount % 1 == 0
        && request.resource.data.savings is number
        && request.resource.data.savings % 1 == 0
        && request.resource.data.total is number
        && request.resource.data.total % 1 == 0
        && request.resource.data.total == request.resource.data.amount + request.resource.data.savings
        && (request.resource.data.type == 'Income'
          ? request.resource.data.savings == 0
          : (request.resource.data.category is string && request.resource.data.category != ''));
    }

    match /budgets/main {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.budgets is map;
      allow delete: if false;
    }
  }
}
